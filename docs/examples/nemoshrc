# An rc file to start from. Copy it to ~/.nemoshrc: a session reads that when ENV is not
# set, and $ENV in its place when it is. Every line is optional.

# History: skip lines that begin with a blank, and a line that repeats the one before.
HISTCONTROL=ignoreboth

# Ctrl-Z at the prompt turns backslashes into slashes, as busybox-w32's does, so a pasted
# C:\Users\nemo becomes C:/Users/nemo. Uncomment this to have it end input instead, as
# cmd's Ctrl-Z does.
# NEMOSH_CTRL_Z=eof

# The prompt: who and where, the git branch, and the last status when it was not 0,
# then the prompt sign on a line of its own.
#
# The branch is read from .git/HEAD rather than by running git, which would start a
# process at every prompt. A worktree, whose .git is a file, shows no branch.
__nemosh_branch() {
	__d=$PWD
	while [ -n "$__d" ]; do
		if [ -f "$__d/.git/HEAD" ]; then
			read -r __head < "$__d/.git/HEAD"
			case $__head in
			"ref: refs/heads/"*) printf ' (%s)' "${__head#ref: refs/heads/}" ;;
			*) printf ' (%.7s)' "$__head" ;;
			esac
			return 0
		fi
		[ "$__d" = "${__d%/*}" ] && return 0
		__d=${__d%/*}
	done
}
PROMPT_COMMAND='__nemosh_status=$?; [ "$__nemosh_status" = 0 ] && __nemosh_status='
PS1='\[\e[1;34m\]\u@\h\[\e[0m\] \[\e[33m\]\w\[\e[0m\]$(__nemosh_branch)${__nemosh_status:+ \[\e[31m\][$__nemosh_status]\[\e[0m\]}\n\$ '

# Aliases. A session has Ubuntu's already, before this file is read: ll='ls -alF',
# la='ls -A', l='ls -CF', and ls, grep, egrep and fgrep with --color=auto, and LS_COLORS
# from dircolors' database. Redefine one here, or take it away; NEMOSH_DEFAULTS=off in the
# environment starts a session with none.
# unalias l
# LS_COLORS="$LS_COLORS*.log=00;33:"; export LS_COLORS

# Completion for programs that ship their own: gh, if it is installed, and git's script
# from Git for Windows, wherever it was installed from. Git for Windows keeps it under
# ucrt64 since it moved to that runtime, and under mingw64 before.
#
# Each is loaded the first time Tab is pressed after its command, not at every start:
# sourced here, they cost about 80 ms for gh's, which runs gh to print it, and 50 ms for
# git's, a long script, on every shell opened (measured 2026-11-15). The function is the
# default specification, `complete -D`, which bash-completion's loader is too: it sources
# the script for the command it is asked about and answers 124, which has the shell look
# the command's specification up again, now that there is one. For any other command it
# answers nothing, and -o bashdefault hands the word to the shell's own completion.
__nemosh_load_completion() {
	case $1 in
	gh)
		command -v gh >/dev/null 2>&1 && . <(gh completion -s bash) && return 124
		;;
	git | gitk)
		for __f in "$HOME"/scoop/apps/git/current/ucrt64 "$HOME"/scoop/apps/git/current/mingw64 \
			"C:/Program Files/Git/ucrt64" "C:/Program Files/Git/mingw64"; do
			__f=$__f/share/git/completion/git-completion.bash
			if [ -r "$__f" ]; then
				. "$__f"
				unset __f
				return 124
			fi
		done
		unset __f
		;;
	esac
	return 1
}
complete -D -o bashdefault -F __nemosh_load_completion
